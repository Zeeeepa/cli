# ====================================
# Z.ai Configuration (Anthropic-Compatible)
# ====================================
ANTHROPIC_API_URL=https://api.z.ai/v1
ANTHROPIC_API_KEY=your-z-ai-api-key-here
ANTHROPIC_MODEL=glm-4.5v

# ====================================
# TestUI Sandbox Configuration
# ====================================
TESTUI_SANDBOX_ENABLED=true
TESTUI_VERBOSE=false
TESTUI_SCREENSHOT_DIR=./screenshots
TESTUI_LOGS_DIR=./logs

# ====================================
# Platform Configuration (auto-detected)
# ====================================
# TESTUI_SANDBOX_PLATFORM=auto  # auto|macos|linux

# ====================================
# Performance Tuning
# ====================================
TESTUI_TIMEOUT=30000
TESTUI_MAX_RETRIES=3

# ====================================
# Chrome/Chromium Configuration
# ====================================
# CHROME_BIN=/path/to/chrome  # Optional: override auto-detection

